# Copy to backend/.env - every setting can also be passed as an environment variable.
SETTLEWISE_ENV=dev
SETTLEWISE_DATABASE_URL=sqlite:///./settlewise.db
# Production: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SETTLEWISE_SECRET_KEY=dev-only-insecure-secret-change-me-in-production

# Delivery phases to switch on (Project Vision, Appendix B): MVP, Growth, Enterprise
SETTLEWISE_ENABLED_PHASES=["MVP"]
SETTLEWISE_DISABLED_PLUGINS=[]

# Synthetic demo users (Sarah + a settlement worker when Enterprise is on)
SETTLEWISE_SEED_DEMO_DATA=true
SETTLEWISE_SEED_DEMO_PASSWORD=settlewise-demo

# AI Settlement Assistant: set an Anthropic API key to answer with Claude.
# Without it the assistant answers offline from the reviewed source summaries.
# ANTHROPIC_API_KEY=
SETTLEWISE_ANTHROPIC_MODEL=claude-opus-5-5
